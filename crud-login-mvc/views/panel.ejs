
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Panel | Gestión de Productos</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="bg-light">

  <header class="bg-primary text-white py-3">
    <div class="container d-flex justify-content-between
                align-items-center">
      <h1 class="h4 mb-0">Gestión de Productos</h1>

        <nav aria-label="Navegación principal"
            class="d-flex align-items-center gap-3">

        <a href="/panel" class="text-white">
            Productos
        </a>

        <button
            type="button"
            id="btnLogout"
            class="btn btn-outline-light btn-sm">
            Cerrar sesión
        </button>

        </nav>

    </div>
  </header>

  <main class="container py-5">

    <section aria-labelledby="titulo-crear" class="mb-5">

  <h2 id="titulo-crear" class="mb-4">
    Registrar producto
  </h2>

  <form id="formProducto">
    <input type="hidden" id="productoId" name="productoId">

    <div class="mb-3">
      <label for="nombre" class="form-label">
        Nombre
      </label>

      <input
        type="text"
        id="nombre"
        name="nombre"
        class="form-control"
        required
      >
    </div>

    <div class="mb-3">
      <label for="precio" class="form-label">
        Precio
      </label>

      <input
        type="number"
        id="precio"
        name="precio"
        class="form-control"
        min="0"
        step="0.01"
        required
      >
    </div>

    <div class="mb-3">
      <label for="cantidad" class="form-label">
        Cantidad
      </label>

      <input
        type="number"
        id="cantidad"
        name="cantidad"
        class="form-control"
        min="0"
        step="1"
        required
      >
    </div>

    <div class="mb-3">
      <label for="descripcion" class="form-label">
        Descripción
      </label>

      <textarea
        id="descripcion"
        name="descripcion"
        class="form-control"
        rows="3"
      ></textarea>
    </div>

    <button
        type="submit"
        id="btnGuardar"
        class="btn btn-primary">
        Guardar producto
    </button>

    <button
        type="button"
        id="btnCancelar"
        class="btn btn-secondary"
        hidden>
        Cancelar edición
    </button>

    <p id="mensajeProducto"
       class="mt-3"
       role="status"
       aria-live="polite"></p>

  </form>

</section>

    <section aria-labelledby="titulo-productos">

      <h2 id="titulo-productos" class="mb-4">
        Listado de productos
      </h2>

      <div class="table-responsive">
        <table class="table table-striped table-bordered">

          <thead class="table-dark">
            <tr>
              <th scope="col">Nombre</th>
              <th scope="col">Precio</th>
              <th scope="col">Cantidad</th>
              <th scope="col">Descripción</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% productos.forEach(function(producto) { %>
                <tr>
                <td><%= producto.nombre %></td>
                <td><%= producto.precio %></td>
                <td><%= producto.cantidad %></td>
                <td><%= producto.descripcion %></td>
                <td>
                    <button
                    type="button"
                    class="btn btn-warning btn-sm btn-editar"
                    data-id="<%= producto.id %>"
                    data-nombre="<%= producto.nombre %>"
                    data-precio="<%= producto.precio %>"
                    data-cantidad="<%= producto.cantidad %>"
                    data-descripcion="<%= producto.descripcion %>">
                    Editar
                    </button>

                    <button
                    type="button"
                    class="btn btn-danger btn-sm btn-eliminar"
                    data-id="<%= producto.id %>"
                    data-nombre="<%= producto.nombre %>">
                    Eliminar
                    </button>
                </td>
                </tr>
            <% }); %>
            </tbody>

        </table>
      </div>

    </section>

  </main>

  <footer class="text-center text-secondary py-3">
    <small>&copy; 2026 Gestión de Productos</small>
  </footer>

  <script>

    async function obtenerCsrfToken() {
        const respuesta = await fetch('/csrfToken', {
            credentials: 'same-origin'
        });

        if (!respuesta.ok) {
            throw new Error('No se pudo obtener el token CSRF');
        }

        const datos = await respuesta.json();

        return datos._csrf;
    }
  
    const formProducto = document.getElementById('formProducto');
    const mensajeProducto = document.getElementById('mensajeProducto');
    const productoId = document.getElementById('productoId');
    const btnGuardar = document.getElementById('btnGuardar');
    const btnCancelar = document.getElementById('btnCancelar');

    const botonesEditar = document.querySelectorAll('.btn-editar');

    botonesEditar.forEach(function(boton) {

    boton.addEventListener('click', function() {

        productoId.value = boton.dataset.id;

        document.getElementById('nombre').value =
        boton.dataset.nombre;

        document.getElementById('precio').value =
        boton.dataset.precio;

        document.getElementById('cantidad').value =
        boton.dataset.cantidad;

        document.getElementById('descripcion').value =
        boton.dataset.descripcion;

        btnGuardar.textContent = 'Actualizar producto';
        btnCancelar.hidden = false;

        document.getElementById('nombre').focus();

    });

    });

    formProducto.addEventListener('submit', async function(event) {

    event.preventDefault();

    const id = productoId.value;

    const producto = {
        nombre: document.getElementById('nombre').value,
        precio: Number(document.getElementById('precio').value),
        cantidad: Number(document.getElementById('cantidad').value),
        descripcion: document.getElementById('descripcion').value
    };

    const url = id
        ? `/productos/${encodeURIComponent(id)}`
        : '/productos';

    const metodo = id ? 'PUT' : 'POST';

    try {
        const csrfToken = await obtenerCsrfToken();
        const respuesta = await fetch(url, {
        method: metodo,
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
        },
        credentials: 'same-origin',
        body: JSON.stringify(producto)
        });

        if (respuesta.ok) {

        mensajeProducto.textContent = id
            ? 'Producto actualizado correctamente'
            : 'Producto registrado correctamente';

        mensajeProducto.className = 'mt-3 text-success';

        window.location.reload();

        } else {

        const error = await respuesta.json();

        mensajeProducto.textContent =
            error.mensaje || 'No se pudo guardar el producto';

        mensajeProducto.className = 'mt-3 text-danger';

        }

    } catch (error) {

        mensajeProducto.textContent =
        'Error de conexión con el servidor';

        mensajeProducto.className = 'mt-3 text-danger';

        console.error(error);

    }

    });

    btnCancelar.addEventListener('click', function() {

    formProducto.reset();
    productoId.value = '';

    btnGuardar.textContent = 'Guardar producto';
    btnCancelar.hidden = true;

    });

    // 4. Eliminar producto
    const botonesEliminar = document.querySelectorAll('.btn-eliminar');

    botonesEliminar.forEach(function(boton) {

    boton.addEventListener('click', async function() {

        const id = boton.dataset.id;
        const nombre = boton.dataset.nombre;

        const confirmado = window.confirm(
        `¿Estás seguro de eliminar el producto "${nombre}"?`
        );

        if (!confirmado) {
        return;
        }

        try {
        const csrfToken = await obtenerCsrfToken();
        const respuesta = await fetch(
            `/productos/${encodeURIComponent(id)}`,
            {
                method: 'DELETE',
                headers: {
                    'X-CSRF-Token': csrfToken
                },
                credentials: 'same-origin'
            }
        );

        if (respuesta.ok) {
            window.location.reload();
        } else {
            mensajeProducto.textContent =
            'No se pudo eliminar el producto';
            mensajeProducto.className = 'mt-3 text-danger';
        }

        } catch (error) {
        mensajeProducto.textContent =
            'Error de conexión con el servidor';
        mensajeProducto.className = 'mt-3 text-danger';
        console.error(error);
        }

    });

    });

    // 5. Cerrar sesión
    document.getElementById('btnLogout')
    .addEventListener('click', async function() {

        try {
        const csrfToken = await obtenerCsrfToken();
        const respuesta = await fetch('/auth/logout', {
            method: 'POST',
            headers: {
                'X-CSRF-Token': csrfToken
            },
            credentials: 'same-origin'
        });

        if (respuesta.ok) {
            window.location.href = '/login';
        } else {
            mensajeProducto.textContent =
            'No se pudo cerrar la sesión';
            mensajeProducto.className = 'mt-3 text-danger';
        }

        } catch (error) {
        mensajeProducto.textContent =
            'Error al cerrar sesión';
        mensajeProducto.className = 'mt-3 text-danger';
        console.error(error);
        }

    });

</script>

</body>
</html>
